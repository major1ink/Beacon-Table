   "name": "поля, модификаторы, характеристики, пути",
   "schema": {
    "fields": {
     "str": {
      "type": "number",
      "path": "abilities.str",
      "label": "Сила",
      "modifierTarget": "abilities.str"
     },
     "str_mod": {
      "type": "computed",
      "formula": "floor((@str - 10) / 2)",
      "label": "x"
     },
     "hp_max": {
      "type": "number",
      "path": "combat.hpMax",
      "label": "Хиты",
      "modifierTarget": "hp.max"
     },
     "half": {
      "type": "computed",
      "formula": "@hp_max / 2",
      "label": "x"
     },
     "name": {
      "type": "text",
      "path": "name",
      "label": "Имя"
     },
     "lvl": {
      "type": "text",
      "path": "level",
      "label": "Уровень"
     },
     "inspired": {
      "type": "bool",
      "path": "inspired",
      "label": "Вдохновение"
     },
     "bonus": {
      "type": "computed",
      "formula": "@lvl + @inspired",
      "label": "x"
     },
     "empty": {
      "type": "number",
      "path": "nothing.here",
      "label": "Пусто"
     },
     "raw": {
      "type": "computed",
      "formula": "@combat.hpMax + @luck + @missing.path",
      "label": "x"
     },
     "note0": {
      "type": "text",
      "path": "notes.0",
      "label": "Заметка"
     },
     "notes_sum": {
      "type": "computed",
      "formula": "@note0 + @notes.1",
      "label": "x"
     },
     "luck2": {
      "type": "computed",
      "formula": "@stat.удача_ночью * 2 + @stat.нет_такой",
      "label": "x"
     },
     "stats": {
      "type": "table",
      "path": "stats",
      "label": "Характеристики",
      "statRows": {
       "name": "name",
       "value": "value"
      },
      "columns": [
       {
        "id": "name",
        "type": "text",
        "path": "name",
        "label": "Название"
       },
       {
        "id": "value",
        "type": "number",
        "path": "value",
        "label": "Значение"
       }
      ]
     },
     "ac_calc": {
      "type": "computed",
      "formula": "10 + @str_mod",
      "label": "x",
      "modifierTarget": "ac"
     },
     "attack": {
      "type": "roll",
      "roll": "1d20 + @str_mod",
      "label": "Атака"
     },
     "bad": {
      "type": "computed",
      "formula": "@name + 1",
      "label": "x"
     },
     "uses_bad": {
      "type": "computed",
      "formula": "@bad * 2",
      "label": "x"
     },
     "uses_roll": {
      "type": "computed",
      "formula": "@attack + 1",
      "label": "x"
     },
     "uses_table": {
      "type": "computed",
      "formula": "@stats + 1",
      "label": "x"
     },
     "div0": {
      "type": "computed",
      "formula": "1 / (@empty)",
      "label": "x"
     }
    }
