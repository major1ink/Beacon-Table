# Обратный прокси с HTTPS для Beacon Table.
#
# Caddy сам получает сертификат Let's Encrypt и продлевает его — от вас нужен
# только домен, направленный A/AAAA-записью на этот сервер, и открытые порты
# 80 и 443.
#
#   sudo apt install caddy           # или https://caddyserver.com/docs/install
#   sudo cp deploy/Caddyfile.example /etc/caddy/Caddyfile
#   # впишите свой домен и почту вместо примеров ниже
#   sudo systemctl reload caddy
#
# Beacon Table при этом должен:
#   - слушать только localhost:  BEACON_ADDR=127.0.0.1:8080
#   - знать, что он за HTTPS:     BEACON_BEHIND_PROXY=true
# (см. beacon.conf / README, раздел «Настройка»).

table.example.com {
	# Почта для уведомлений Let's Encrypt об истечении сертификата.
	tls you@example.com

	# Сжатие для JSON API и HTML; на карты/видео/аудио не влияет — они уже
	# сжаты.
	encode zstd gzip

	# WebSocket (стол, трансляция) Caddy проксирует сам, ничего настраивать
	# не нужно — в отличие от nginx.
	#
	# В docker-compose замените адрес на имя сервиса: beacon-table:8080
	reverse_proxy 127.0.0.1:8080

	# Потолок на тело запроса: чуть больше самой крупной легальной загрузки —
	# импорта мира (.zip до 1 ГБ, см. maxWorldImportSize). Карты/токены/аудио
	# (до 200 МБ) укладываются с запасом. Всё, что меньше, приложение
	# ограничивает само по каждому маршруту.
	request_body {
		max_size 1100MB
	}

	header {
		# Только по HTTPS в течение года. Убедитесь, что домен больше не
		# нужен по http, прежде чем оставлять это надолго.
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		# Окна стола (лист, журнал, импорт) открываются во фреймах того же
		# origin — стороннему сайту встроить стол нельзя.
		X-Frame-Options "SAMEORIGIN"
		-Server
	}

	log {
		output file /var/log/caddy/beacon-table.log {
			roll_size 10MB
			roll_keep 5
		}
	}
}

# --- Что прокси НЕ решает ---------------------------------------------------
#
# Приложение видит адрес самого Caddy (127.0.0.1), а не игрока: ограничение
# частоты входа и коды подтверждения трансляции считаются по этому одному
# адресу на весь сервер. Заголовок X-Forwarded-For Caddy проставляет, но
# приложение ему пока не доверяет (подделать его тривиально, если прокси
# настроен неаккуратно). Для одной группы это не мешает; для публичного
# демо с регистрацией — стоит учитывать.
