<?xml version="1.0" encoding="UTF-8"?>
<!-- Info.plist для «Beacon Table.app» (см. .github/workflows/desktop.yml);
     __VERSION__ подставляет сборка. -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>CFBundleName</key>
  <string>Beacon Table</string>
  <key>CFBundleDisplayName</key>
  <string>Beacon Table</string>
  <key>CFBundleIdentifier</key>
  <string>ru.beacontable.BeaconTable</string>
  <key>CFBundleVersion</key>
  <string>__VERSION__</string>
  <key>CFBundleShortVersionString</key>
  <string>__VERSION__</string>
  <key>CFBundleExecutable</key>
  <string>beacon-table-desktop</string>
  <key>CFBundleIconFile</key>
  <string>icon</string>
  <key>CFBundlePackageType</key>
  <string>APPL</string>
  <key>LSMinimumSystemVersion</key>
  <string>11.0</string>
  <key>NSHighResolutionCapable</key>
  <true/>
  <!-- Стол открывается по http: localhost, адрес в локальной сети или
       свой сервер без TLS. Без этого WebKit на macOS такие адреса режет. -->
  <key>NSAppTransportSecurity</key>
  <dict>
    <key>NSAllowsArbitraryLoads</key>
    <true/>
  </dict>
  <key>NSLocalNetworkUsageDescription</key>
  <string>Телевизор и игроки подключаются к столу по локальной сети.</string>
</dict>
</plist>
